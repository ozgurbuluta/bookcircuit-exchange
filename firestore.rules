rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Helper functions ----
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // True when the signed-in user is a participant of the given conversation.
    // Safe to call at read time and when adding messages/participants AFTER the
    // parent conversation document already exists.
    function isConvoParticipant(conversationId) {
      return isAuthenticated() &&
        request.auth.uid in
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    // True when the signed-in user is the initiator or recipient of the trade.
    function isTradeParticipant(tradeId) {
      let trade = get(/databases/$(database)/documents/trades/$(tradeId)).data;
      return isAuthenticated() &&
        (trade.initiatorId == request.auth.uid || trade.recipientId == request.auth.uid);
    }

    // ---- Users ----
    match /users/{userId} {
      // Require authentication to read profiles (prevents anonymous email harvesting).
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }

    // ---- Books ----
    match /books/{bookId} {
      // Listings are publicly browsable.
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // ---- Book interests ----
    match /bookInterests/{interestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // ---- Book requests ----
    match /bookRequests/{requestId} {
      allow read: if isAuthenticated() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.requesterId == request.auth.uid;
      // Only requester or owner may update (e.g. cancel / accept / reject).
      allow update: if isAuthenticated() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid);
      allow delete: if false;
    }

    // ---- Notifications ----
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      // Any authenticated user may create a notification addressed to another
      // user (e.g. a book request notifies the owner).
      allow create: if isAuthenticated();
      // The recipient may update (mark read) or remove their own notifications.
      allow update, delete: if isOwner(resource.data.userId);
    }

    // ---- Trades ----
    match /trades/{tradeId} {
      allow read: if isAuthenticated() &&
        (resource.data.initiatorId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.initiatorId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.initiatorId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid);
      allow delete: if false; // Never delete trades, only update status.

      // Trade items subcollection
      match /tradeItems/{itemId} {
        // Read requires participation in the parent trade (which exists by read time).
        allow read: if isTradeParticipant(tradeId);
        // Items are created in the same batch as the trade, so the parent does
        // not yet exist; validate the creator is a participant via the item fields.
        allow create: if isAuthenticated() &&
          (request.resource.data.ownerId == request.auth.uid ||
           request.resource.data.recipientId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // ---- Trade history (audit trail) ----
    match /tradeHistory/{historyId} {
      allow read: if isTradeParticipant(resource.data.tradeId);
      allow create: if isAuthenticated() &&
        request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Conversations ----
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      // Participants subcollection (created/updated after the conversation exists)
      match /participants/{participantId} {
        allow read, write: if isConvoParticipant(conversationId);
      }

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isConvoParticipant(conversationId);
        allow create: if isConvoParticipant(conversationId) &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isOwner(resource.data.userId);
        allow delete: if false;
      }
    }

    // ---- Blog posts (public read, admin write) ----
    match /blogPosts/{postId} {
      allow read: if true;
      // Writes require an admin custom claim:
      //   admin.auth().setCustomUserClaims(uid, { admin: true })
      allow write: if isAdmin();
    }
  }
}
