rules_version = '2';

// Turtle Turning Pages v1 — security rules for the redesigned schema
// (docs/REDESIGN_PLAN.md §3). Economy architecture is decision D1 "hybrid":
// trade transitions run as client-side transactions behind the app's
// TradeEngine, so these rules constrain WHICH fields non-owners may touch;
// they cannot verify cross-document invariants (points conservation). That
// residual trust gap is accepted for the closed TestFlight and closes when
// transitions move into callable functions before public launch.

service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Helpers ----
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when the signed-in user is the requester or owner of the trade.
    function isTradeParticipant(tradeId) {
      let trade = get(/databases/$(database)/documents/trades/$(tradeId)).data;
      return isAuthenticated() &&
        (trade.requesterId == request.auth.uid || trade.ownerId == request.auth.uid);
    }

    // ---- Users ----
    match /users/{userId} {
      // Authenticated-only reads (prevents anonymous email harvesting).
      allow read: if isAuthenticated();

      // A user may create their own doc, but never pre-loaded with points:
      // the welcome grant is a separate guarded transition below.
      allow create: if isOwner(userId) &&
        request.resource.data.points == 0 &&
        request.resource.data.pointsGranted == false;

      allow update: if isOwner(userId) ?
          (
            // Profile edits: identity/settings fields only…
            affectedKeys().hasOnly([
              'fullName', 'name', 'avatarInitials', 'avatarUrl',
              'postalCode', 'areaLabel', 'languages',
              'centroidLat', 'centroidLng',
              'notifyNewBookNearby', 'notifyJournal', 'fcmToken', 'updatedAt'
            ])
            ||
            // …or the one-time 200-pt welcome grant (spec §4.2).
            (
              affectedKeys().hasOnly(['points', 'pointsGranted', 'updatedAt']) &&
              resource.data.pointsGranted == false &&
              request.resource.data.pointsGranted == true &&
              request.resource.data.points == resource.data.points + 200
            )
          )
        : (
            // TradeEngine counterparty writes: escrow/refund/release and
            // denormalized counters only — never identity fields.
            isAuthenticated() &&
            affectedKeys().hasOnly([
              'points', 'tradeCount', 'ratingAvg', 'ratingCount', 'updatedAt'
            ])
          );

      allow delete: if isOwner(userId);
    }

    // ---- Books ----
    match /books/{bookId} {
      // Listings are publicly browsable.
      allow read: if true;

      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'on_shelf' &&
        request.resource.data.condition in ['like_new', 'very_good', 'good', 'well_read'] &&
        request.resource.data.source in ['scan', 'manual'];

      // Owner edits freely; trade counterparties may only lock/unlock,
      // bump the request counter, or receive ownership at swap.
      allow update: if isOwner(resource.data.ownerId) ||
        (
          isAuthenticated() &&
          affectedKeys().hasOnly(['status', 'requestCount', 'ownerId', 'updatedAt'])
        );

      allow delete: if isOwner(resource.data.ownerId);
    }

    // ---- Trades (single-book, spec §4) ----
    match /trades/{tradeId} {
      allow read: if isAuthenticated() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid);

      allow create: if isAuthenticated() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.ownerId != request.auth.uid &&
        request.resource.data.status == 'requested' &&
        request.resource.data.offer in ['points_50', 'book'] &&
        (request.resource.data.offer != 'book' ||
         request.resource.data.offeredBookId is string);

      // Participants transition trades; terminal trades are frozen.
      allow update: if isAuthenticated() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid) &&
        !(resource.data.status in ['swapped', 'cancelled', 'declined', 'expired']) &&
        // Immutable identity of a trade.
        request.resource.data.bookId == resource.data.bookId &&
        request.resource.data.requesterId == resource.data.requesterId &&
        request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if false; // Never delete trades, only close them.

      // Per-trade chat thread (spec §9) — user + system messages.
      match /messages/{messageId} {
        allow read: if isTradeParticipant(tradeId);
        allow create: if isTradeParticipant(tradeId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.type in ['user', 'system'];
        allow update, delete: if false;
      }
    }

    // ---- Ratings (spec §3, one per direction per trade) ----
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();

      // Doc ID convention "{tradeId}_{fromId}" enforces one rating per
      // direction; only participants of a swapped trade may rate.
      allow create: if isAuthenticated() &&
        request.resource.data.fromId == request.auth.uid &&
        ratingId == request.resource.data.tradeId + '_' + request.auth.uid &&
        request.resource.data.stars >= 1 &&
        request.resource.data.stars <= 5 &&
        (!('note' in request.resource.data) ||
         request.resource.data.note == null ||
         request.resource.data.note.size() <= 140) &&
        isTradeParticipant(request.resource.data.tradeId) &&
        get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.status == 'swapped';

      allow update, delete: if false;
    }

    // ---- Notifications (spec §8) ----
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      // Any authenticated user may notify another (e.g. a request notifies
      // the owner) — but only with a well-formed payload.
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['userId', 'type', 'refId', 'read']) &&
        request.resource.data.read == false;
      // The recipient may mark read or remove their own notifications.
      allow update: if isOwner(resource.data.userId) &&
        affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.userId);
    }

    // ---- Journal (reuses blogPosts: public read, admin write) ----
    match /blogPosts/{postId} {
      allow read: if true;
      // Writes require an admin custom claim:
      //   admin.auth().setCustomUserClaims(uid, { admin: true })
      allow write: if isAdmin();
    }

    // ---- LEGACY: pre-redesign chat, kept read/write until Phase I ----
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /participants/{participantId} {
        allow read, write: if isAuthenticated() &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isAuthenticated() &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- RETIRED collections (locked; deleted in the Phase L reset) ----
    match /bookInterests/{id} {
      allow read, write: if false;
    }
    match /bookRequests/{id} {
      allow read, write: if false;
    }
    match /tradeHistory/{id} {
      allow read, write: if false;
    }
  }
}
