# Firebase Configuration
# Get these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Google Maps API
# You MUST get a valid API key for the postal code autocomplete to work
# Go to https://developers.google.com/maps/documentation/javascript/get-api-key
# Make sure to enable the Places API and Geocoding API for your key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
